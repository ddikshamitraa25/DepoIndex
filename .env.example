# Optional LLM provider. Leave unset to use the deterministic fallback segmenter.
# Never commit a real .env file.

# openai | ollama | none
DEPOINDEX_LLM_PROVIDER=none

# OpenAI-compatible API (only if DEPOINDEX_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (only if DEPOINDEX_LLM_PROVIDER=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Pipeline
DEPOINDEX_PDF_PATH=data/Persis_Yu_Deposition.pdf
DEPOINDEX_TEMPERATURE=0
